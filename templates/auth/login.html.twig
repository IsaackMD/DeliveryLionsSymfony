{% extends 'base.html.twig' %}

{% block title %}Inicio de Sesión{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
    <section class="auth-shell">
        <div class="auth-card">
            <div class="auth-card__illustration">
                <span class="auth-badge">Bienvenido de nuevo</span>
                <h1 class="auth-card__title">Inicia sesión y sigue tu pedido en tiempo real</h1>
                <p class="auth-card__subtitle">Gestiona tus compras, guarda tus favoritos y recibe notificaciones instantáneas en cada etapa del envío.</p>
                <ul class="auth-list">
                    <li>Seguimiento minuto a minuto</li>
                    <li>Historial de pedidos siempre disponible</li>
                    <li>Experiencia rápida en cualquier dispositivo</li>
                </ul>
                <figure class="auth-figure">
                    <img src="{{ asset('imgs/imgsIndex/img3.png') }}" alt="Clientes felices con Delivery Lions">
                    <figcaption>Delivery Lions conecta tus antojos con la ciudad.</figcaption>
                </figure>
            </div>
            <div class="auth-card__form">
                <a class="auth-back" href="javascript:history.back()">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    <span>Regresar</span>
                </a>
                <div class="auth-card__header">
                    <h2>Accede a tu cuenta</h2>
                    <p>Ingresa tus credenciales para continuar con tus pedidos y recompensas.</p>
                </div>
                {% if error %}
                    <div class="auth-alert auth-alert--error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="auth-alert auth-alert--info">
                        Ya iniciaste sesión como {{ app.user.userIdentifier }}.
                        <a href="{{ path('app_logout') }}">Cerrar sesión</a>
                    </div>
                {% endif %}

                <form method="post" class="auth-form" autocomplete="on">
                    <div class="auth-field">
                        <label for="username">Correo electrónico</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="auth-input" autocomplete="email" required autofocus>
                    </div>
                    <div class="auth-field">
                        <label for="password">Contraseña</label>
                        <input type="password" name="_password" id="password" class="auth-input" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="auth-submit" type="submit">Acceder</button>
                </form>
                <p class="auth-card__footer">¿Aún no tienes una cuenta? <a href="{{ path('app_register') }}">Regístrate en Delivery Lions</a></p>
            </div>
        </div>
    </section>
{% endblock %}
