{% extends 'base.html.twig' %}

{% block title %}Registro de Usuario{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/register.css') }}">
{% endblock %}

{% block body %}
    <!-- Animated Background -->
    <div class="register-background">
        <div class="circle-animated circle-1"></div>
        <div class="circle-animated circle-2"></div>
        <div class="circle-animated circle-3"></div>
        <div class="circle-animated circle-4"></div>
        <div class="circle-animated circle-5"></div>
    </div>

    <div class="register-container">
        <div class="btn-back-content">
            <a class="back_btn" href="javascript:history.go(-1);" type="button">
                <i class="fa-solid fa-chevron-left"></i> Regresar
            </a>
        </div>

        <div class="formularioRegistro">
            <div class="register-header">
                <div class="icon-wrapper">
                    <i class="fa-solid fa-circle-user user-icon"></i>
                    <div class="icon-pulse"></div>
                </div>
                <h1 class="register-title">Registro de Usuario</h1>
                <p class="register-subtitle">Únete a nuestra comunidad</p>
            </div>

            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2" viewBox="0 0 16 16" role="img" aria-label="Warning:">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    <strong>Error: </strong> {{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {'attr' : { 'class' : 'formularioCuerpo' , 'enctype': 'multipart/form-data'}}) }}

            <div class="form-section">
                <div class="form-row">
                    <div class="form-group">
                        {{ form_row(registrationForm.nombre) }}
                    </div>
                    <div class="form-group">
                        {{ form_row(registrationForm.ApellidoP) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_row(registrationForm.ApellidoM) }}
                    </div>
                    <div class="form-group">
                        {{ form_row(registrationForm.username) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_row(registrationForm.email) }}
                    </div>
                    <div class="form-group">
                        {{ form_row(registrationForm.plainPassword) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_row(registrationForm.Sexo) }}
                    </div>
                    <div class="form-group">
                        {{ form_row(registrationForm.Telefono) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_row(registrationForm.Fecha_Na) }}
                    </div>
                    <div class="form-group file-upload-group">
                        <label class="form-label">Imagen de Perfil</label>
                        <div class="file-upload-wrapper">
                            <input class="form-control file-input" name="fotito" id="fotito" type="file" accept=".jpg" required/>
                            <label for="fotito" class="file-label">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span>Seleccionar imagen</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-row terms-row">
                    {{ form_row(registrationForm.agreeTerms) }}
                </div>

                <div class="button-wrapper">
                    <button type="submit" class="btn-register">
                        <span class="btn-text">Registrarse</span>
                        <span class="btn-icon"><i class="fa-solid fa-arrow-right"></i></span>
                    </button>
                </div>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>

{% endblock %}
