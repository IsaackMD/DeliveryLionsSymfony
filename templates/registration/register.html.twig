{% extends 'base.html.twig' %}

{% block title %}Register De Residente{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
    <section class="auth-shell">
        <div class="auth-card">
            <div class="auth-card__illustration">
                <span class="auth-badge">Únete a Delivery Lions</span>
                <h1 class="auth-card__title">Crea tu cuenta y potencia tu experiencia gastronómica</h1>
                <p class="auth-card__subtitle">Con tu perfil personalizado podrás reservar pedidos, guardar negocios favoritos y recibir promociones exclusivas.</p>
                <ul class="auth-list">
                    <li>Perfil con foto para una atención más cercana</li>
                    <li>Notificaciones y seguimiento en vivo</li>
                    <li>Acceso rápido desde cualquier dispositivo</li>
                </ul>
                <figure class="auth-figure">
                    <img src="{{ asset('imgs/imgsIndex/img1.png') }}" alt="Nuevo usuario registrándose">
                    <figcaption>Regístrate y descubre todo lo que Delivery Lions tiene para ti.</figcaption>
                </figure>
            </div>
            <div class="auth-card__form">
                <a class="auth-back" href="javascript:history.back()">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    <span>Regresar</span>
                </a>
                <div class="auth-card__header">
                    <h2>Completa tus datos</h2>
                    <p>Cuéntanos un poco sobre ti para personalizar tus pedidos y recomendaciones.</p>
                </div>

                {% if error %}
                    <div class="auth-alert auth-alert--error">{{ error }}</div>
                {% endif %}

                {% set formErrors = form_errors(registrationForm) %}
                {% if formErrors is not empty %}
                    <div class="auth-alert auth-alert--error auth-alert--list">{{ formErrors|raw }}</div>
                {% endif %}

                {{ form_start(registrationForm, {'attr' : { 'class' : 'auth-form auth-form--grid', 'enctype': 'multipart/form-data'}}) }}
                    <div class="auth-grid">
                        {{ form_row(registrationForm.nombre, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.ApellidoP, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.ApellidoM, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.username, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.email, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.plainPassword, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.Sexo, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.Telefono, {'row_attr': {'class': 'auth-field'}, 'attr': {'class': 'auth-input'}}) }}
                        {{ form_row(registrationForm.Fecha_Na, {'row_attr': {'class': 'auth-field auth-field--full'}, 'attr': {'class': 'auth-input'}}) }}
                        <div class="auth-field auth-field--full auth-field--file">
                            <label for="fotito">Fotografía de perfil (JPG)</label>
                            <input class="auth-input" name="fotito" id="fotito" type="file" accept=".jpg" required>
                            <span class="auth-hint">Elige una imagen cuadrada menor a 2&nbsp;MB para una mejor visualización.</span>
                        </div>
                    </div>
                    <div class="auth-checkbox">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'auth-checkbox__input'}}) }}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'auth-checkbox__label'}}) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                    <button type="submit" class="auth-submit">Crear mi cuenta</button>
                {{ form_end(registrationForm) }}
            </div>
        </div>
    </section>
{% endblock %}

