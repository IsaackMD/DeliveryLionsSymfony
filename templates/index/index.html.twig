    </div>
    <div class="about-grid">
        <div class="about-gallery" data-animate-child>
            <img src="{{ asset('imgs/imgsIndex/img4.png') }}" alt="Equipo de Delivery Lions" class="about-gallery__item about-gallery__item--featured" loading="lazy">
            <div class="about-gallery__stack">
                <img src="{{ asset('imgs/imgsIndex/img2.png') }}" alt="Variedad de platos" class="about-gallery__item" loading="lazy">
                <img src="{{ asset('imgs/imgsIndex/img3.png') }}" alt="Entrega puntual" class="about-gallery__item" loading="lazy">
