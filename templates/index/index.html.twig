            <div class="about-highlights">
                <div class="about-highlight" data-animate-child>
                    <span class="about-highlight__value">+45</span>
                    <span class="about-highlight__label">Negocios aliados creciendo con nosotros</span>
                </div>
                <div class="about-highlight" data-animate-child>
                    <span class="about-highlight__value">360º</span>
                    <span class="about-highlight__label">Cobertura integral: pedidos, envíos y reservas</span>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const animatedBlocks = document.querySelectorAll('[data-animate]');
            const childBlocks = document.querySelectorAll('[data-animate-child]');
            const heroSection = document.getElementById('inicio');

            const revealTarget = (target) => {
                if (!target) {
                    return;
                }

                target.classList.add('is-visible');
                target.querySelectorAll('[data-animate-child]').forEach((element, index) => {
                    element.classList.add('is-visible');
                    if (!element.style.getPropertyValue('--animate-delay')) {
                        element.style.setProperty('--animate-delay', `${(index + 1) * 90}ms`);
                    }
                });
            };

            const revealHashTarget = () => {
                const { hash } = window.location;
                if (!hash) {
                    return;
                }

                const target = document.querySelector(hash);
                if (!target) {
                    return;
                }

                revealTarget(target);
            };

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            obs.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: 0.2
                });

                animatedBlocks.forEach((element) => {
                    const delay = element.dataset.animateDelay;
                    if (delay) {
                        element.style.setProperty('--animate-delay', `${delay}ms`);
                    }
                    observer.observe(element);
                });

                childBlocks.forEach((element, index) => {
                    element.classList.add('animate-child');
                    element.style.setProperty('--animate-delay', `${(index + 1) * 90}ms`);
                    observer.observe(element);
                });
            } else {
                animatedBlocks.forEach((element) => element.classList.add('is-visible'));
                childBlocks.forEach((element, index) => {
                    element.classList.add('animate-child', 'is-visible');
                    element.style.setProperty('--animate-delay', `${(index + 1) * 90}ms`);
                });
            }

            if (heroSection) {
                requestAnimationFrame(() => {
                    revealTarget(heroSection);
                });
            }

            revealHashTarget();
            window.addEventListener('hashchange', revealHashTarget);
        });
    </script>
{% endblock %}
