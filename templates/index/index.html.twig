                <span class="hero__stat-label">Restaurantes aliados</span>
            </div>
            <div class="hero__stat">
                <span class="hero__stat-value">15 min</span>
                <span class="hero__stat-label">Entrega media</span>
            </div>
            <div class="hero__stat">
                <span class="hero__stat-value">98%</span>
                <span class="hero__stat-label">Clientes satisfechos</span>
            </div>
        </div>
    </div>
    <div class="hero__visual" data-animate="fade-left">
        <div class="hero__gallery">
            <img src="{{ asset('imgs/imgsIndex/img1.png') }}" alt="Hamburguesa gourmet" class="hero__gallery-item hero__gallery-item--primary" loading="lazy">
            <img src="{{ asset('imgs/imgsIndex/img2.png') }}" alt="Postre artesanal" class="hero__gallery-item hero__gallery-item--secondary" loading="lazy">
            <img src="{{ asset('imgs/imgsIndex/img3.png') }}" alt="Plato saludable" class="hero__gallery-item hero__gallery-item--tertiary" loading="lazy">
        </div>
        <div class="hero__card" data-animate-child>
            <div>
